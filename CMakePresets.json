{
   "version": 8,
   "configurePresets": [
      {
         "name": "base",
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build/",
         "cacheVariables": {
            "MEG_ENABLE_TESTING": true,
            "CMAKE_C_FLAGS": "-Wall -Wextra -Werror -pedantic-errors",
            "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror -pedantic-errors -fno-exceptions -fno-rtti"
         }
      },
      {
         "name": "Debug",
         "inherits": "base",
         "binaryDir": "${sourceDir}/build/",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "CMAKE_C_FLAGS_DEBUG": "-fno-omit-frame-pointer -O0 -g3",
            "CMAKE_CXX_FLAGS_DEBUG": " -fno-omit-frame-pointer -O0 -g3"
         }
      },
      {
         "name": "Release",
         "inherits": "base",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_C_FLAGS": "-O3 -flto",
            "CMAKE_CXX_FLAGS": "-O3 -flto"
         }
      },
      {
         "name": "Unitests",
         "inherits": "Debug",
         "binaryDir": "${sourceDir}/build/",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "CMAKE_C_FLAGS_DEBUG": "-O0 -g3",
            "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g3",
            "MEG_ENABLE_TESTING": true
         }
      }
   ]
}
