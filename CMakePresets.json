{
   "version": 8,
   "configurePresets": [
      {
         "name": "default",
         "description": "Default preset",
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "cacheVariables": {
            "CMAKE_C_FLAGS": "-Wall -Wextra -Werror -pedantic-errors",
            "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror -pedantic-errors -fno-exceptions -fno-rtti"
         }
      },
      {
         "name": "Debug",
         "description": "Enable debugging",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "CMAKE_C_FLAGS_DEBUG": "-O0 -g",
            "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g"
         }
      }
   ]
}